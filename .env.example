# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only. Never expose in NEXT_PUBLIC_* variables or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Social account OAuth - server only
SOCIAL_OAUTH_REDIRECT_BASE_URL=https://your-socialos-host.example
SOCIAL_OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters
SOCIAL_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
SOCIAL_TOKEN_KEY_VERSION=v1

# Google OAuth for YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn OpenID Connect (member profile only)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
