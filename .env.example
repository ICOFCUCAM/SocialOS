# Frontend development only. Populate from: supabase status
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-publishable-or-anon-key

# Backend only. Never expose in NEXT_PUBLIC_* variables or commit real values.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
